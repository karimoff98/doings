{
  "name": "doings",
  "private": true,
  "version": "0.1.21",
  "type": "module",
  "description": "Local-first task manager for macOS and Windows.",
  "license": "MIT",
  "author": "karimoff98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karimoff98/doings.git"
  },
  "bugs": {
    "url": "https://github.com/karimoff98/doings/issues"
  },
  "homepage": "https://github.com/karimoff98/doings#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "tsc --noEmit && oxlint --deny-warnings && prettier --check . && vitest run",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "VITE_DEV_SERVER_URL=http://localhost:5273 electron .",
    "desktop:preview": "npm run build && electron .",
    "package:mac": "npm run verify && npm run build && electron-builder --mac --publish never",
    "package:win": "npm run verify && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "immer": "11.1.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.eduardkarimov.doings",
    "productName": "Doings",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Doings"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
